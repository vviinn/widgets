{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "lib": ["dom", "es2017", "es2019"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2017",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react",
    "jsxFactory": "h",
    "resolveJsonModule": true,
    "strict": false,
    "types": [
      "jest",
      "node",
      "google.analytics",
      "gtag.js",
      "dom-speech-recognition"
    ]
  },
  "include": ["src", "types/jsx.d.ts"],
  "exclude": ["node_modules"]
}

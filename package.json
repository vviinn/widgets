{
  "name": "mediaopt-vpr",
  "version": "0.2.2",
  "description": "WebComponent for Mediaopt Visual Product Recommendations",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/medaopt-vpr/medaopt-vpr.js",
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build_interfaces": "node ./scripts/generate-interfaces.js ./src/interfaces/generated.ts",
    "build": "stencil build --docs",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate",
    "storybook": "start-storybook -p 6006 -s www",
    "build-storybook": "build-storybook"
  },
  "devDependencies": {
    "@babel/core": "^7.11.6",
    "@stencil/core": "^1.12.2",
    "@stencil/store": "^1.3.0",
    "@storybook/addon-actions": "^6.0.22",
    "@storybook/addon-controls": "^6.0.22",
    "@storybook/addon-essentials": "^6.0.22",
    "@storybook/addon-links": "^6.0.22",
    "@storybook/addon-notes": "^5.3.21",
    "@storybook/web-components": "^6.0.22",
    "@types/jest": "24.9.1",
    "@types/puppeteer": "2.0.1",
    "babel-loader": "^8.1.0",
    "jest": "24.9.0",
    "jest-cli": "^24.9.0",
    "lit-html": "^1.3.0",
    "puppeteer": "2.1.1",
    "react-is": "^16.13.1"
  },
  "license": "MIT",
  "dependencies": {
    "@manifoldco/swagger-to-ts": "^2.0.0",
    "@types/google.analytics": "0.0.40",
    "@types/node": "^14.0.6",
    "dotenv": "^8.2.0",
    "fp-ts": "^2.6.2",
    "js-yaml": "^3.14.0",
    "rollup-plugin-dotenv": "^0.3.0"
  }
}

{
  "name": "vviinn-widgets",
  "version": "2.8.0",
  "description": "vviinn web components",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/vviinn-widgets/vviinn-vpr.js",
  "files": [
    "dist/",
    "www/"
  ],
  "scripts": {
    "build": "stencil build --docs",
    "postbuild": "cp .npmrc ./dist",
    "build.watch": "stencil build --watch --docs",
    "build.docs": "stencil build --docs",
    "build_interfaces": "node ./scripts/generate-interfaces.js ./src/interfaces/generated.ts",
    "generate": "stencil generate",
    "start": "stencil build --dev --watch --serve --docs",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "release": "standard-version",
    "release:minor": "npm run release -- --release-as minor",
    "release:patch": "npm run release -- --release-as patch",
    "artifactregistry-login": "npx google-artifactregistry-auth"
  },
  "license": "MIT",
  "dependencies": {
    "@rgba-image/lanczos": "^0.1.1",
    "@sentry/browser": "^6.15.0",
    "@sentry/tracing": "^6.15.0",
    "@types/google.analytics": "0.0.41",
    "@types/gtag.js": "0.0.4",
    "@types/node": "^14.14.22",
    "dotenv": "^8.2.0",
    "enhanced-ecommerce-types": "0.0.3",
    "fp-ts": "^2.12.3",
    "openapi-typescript": "^4.4.0",
    "rxjs": "^7.5.5",
    "save-dev": "^0.0.1-security",
    "standard-version": "^9.3.2",
    "tslib": "^1.14.1",
    "typescript": "^4.6.3",
    "uuid": "^8.3.2",
    "vviinn-tracking-client-ts": "^1.0.0",
    "whatwg-fetch": "^3.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.16.12",
    "@stencil-community/postcss": "^2.1.0",
    "@stencil/core": "^2.9.0",
    "@stencil/store": "^1.5.0",
    "@types/autoprefixer": "^10.2.0",
    "@types/jest": "^26.0.21",
    "@types/uuid": "^8.3.4",
    "autoprefixer": "^10.4.12",
    "babel-loader": "^8.2.3",
    "cssnano": "^5.1.13",
    "cssnano-preset-advanced": "^5.3.8",
    "jest": "^26.6.3",
    "jest-cli": "^26.6.3",
    "jest-config": "^27.3.1",
    "puppeteer": "^10.0.0",
    "rollup-plugin-dotenv": "^0.3.0",
    "storybook-addon-designs": "^6.2.1",
    "vite-plugin-replace": "^0.1.1",
    "workbox-build": "^4.3.1",
    "yocto-queue": "^1.0.0"
  }
}

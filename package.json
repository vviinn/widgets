{
  "name": "vviinn-widgets",
  "version": "2.228.0",
  "description": "AI-powered search and product discovery widgets for e-commerce storefronts, built as Web Components with Stencil.",
  "keywords": [
    "web-components",
    "stenciljs",
    "ecommerce",
    "visual-search",
    "product-search",
    "product-discovery",
    "shop-the-look",
    "vviinn"
  ],
  "author": "Mediaopt",
  "homepage": "https://docs.vviinn.com/widgets/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vviinn/widgets.git"
  },
  "bugs": {
    "url": "https://github.com/vviinn/widgets/issues"
  },
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/vviinn-widgets/vviinn-vpr.js",
  "files": [
    "dist/",
    "www/build/",
    "docs.json",
    "NOTICE"
  ],
  "scripts": {
    "build": "ENV=production stencil build --docs",
    "postbuild": "node scripts/verify-no-dev-leak.js && node scripts/collect-sbom.js",
    "build.watch": "stencil build --watch --docs",
    "build.docs": "stencil build --docs",
    "build_interfaces": "node ./scripts/generate-interfaces.js ./src/interfaces/generated.ts",
    "build.favicons": "node ./scripts/generate-favicons.js",
    "generate": "stencil generate",
    "start": "npm run build_interfaces && ENV=local stencil build --dev --watch --serve --docs",
    "test": "stencil test --spec",
    "test.coverage": "stencil test --spec -- --coverage",
    "test.watch": "stencil test --spec --watchAll",
    "artifactregistry-login": "npx google-artifactregistry-auth",
    "lint": "eslint . --max-warnings 70",
    "lint.fix": "eslint . --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,css,scss,json}'",
    "update.openapi": "gh api repos/vviinn/platform-api/contents/docs/merchant-openapi.yaml?ref=develop --jq '.content' | base64 -d > openapi/merchant-openapi.yaml && echo 'Synced: openapi/merchant-openapi.yaml'",
    "prepare": "husky"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.22.1 <23.0.0"
  },
  "dependencies": {
    "@rgba-image/lanczos": "^0.1.1",
    "cropperjs": "^1.5.13",
    "fp-ts": "^2.12.3",
    "i18next": "^23.2.11",
    "marked": "^17.0.5",
    "rxjs": "^7.5.5",
    "swiper": "^12.1.2",
    "uuid": "^11.1.1",
    "vviinn-tracking-client-ts": "^1.7.6"
  },
  "devDependencies": {
    "@babel/core": "^7.16.12",
    "@stencil-community/eslint-plugin": "^0.10.0",
    "@stencil/core": "^4.31.0",
    "@stencil/store": "^2.0.8",
    "@types/dom-speech-recognition": "^0.0.4",
    "@types/google.analytics": "0.0.41",
    "@types/gtag.js": "0.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.1.2",
    "dotenv": "^8.2.0",
    "enhanced-ecommerce-types": "0.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "jest-config": "^29.7.0",
    "lint-staged": "^17.4.1",
    "openapi-typescript": "^4.4.0",
    "postcss": "^8.5.24",
    "prettier": "3.4.2",
    "rollup-plugin-dotenv": "^0.5.0",
    "rollup-plugin-sbom": "^4.0.1",
    "storybook-addon-designs": "^6.2.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0",
    "yargs": "^17.7.3"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "^1.1.12"
    },
    "minimatch@10": {
      "brace-expansion": "^5.0.12"
    }
  }
}

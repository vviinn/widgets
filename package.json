{
  "name": "mediaopt-vpr",
  "version": "0.0.4",
  "description": "WebComponent for Mediaopt Visual Product Recommendations",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/medaopt-vpr/medaopt-vpr.js",
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build_interfaces": "node ./scripts/generate-interfaces.js ./src/interfaces/generated.ts",
    "build": "stencil build --docs",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate"
  },
  "devDependencies": {
    "@stencil/core": "^1.12.2",
    "@stencil/store": "^1.3.0",
    "@types/jest": "24.9.1",
    "@types/puppeteer": "2.0.1",
    "jest": "24.9.0",
    "jest-cli": "^24.9.0",
    "puppeteer": "2.1.1"
  },
  "license": "MIT",
  "dependencies": {
    "@manifoldco/swagger-to-ts": "^2.0.0",
    "@types/node": "^14.0.6",
    "dotenv": "^8.2.0",
    "fp-ts": "^2.6.2",
    "js-yaml": "^3.14.0",
    "rollup-plugin-dotenv": "^0.3.0"
  }
}
